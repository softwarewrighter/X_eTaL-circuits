## Heatmap: one attention head of a capture drawn as an SVG heatmap,
## a row per query and a column per key, each cell the weight in whole
## percent, the prompt's tokens on both axes. It shows where a head
## looks: an observation, not evidence that the head matters.
##
## Import it with an alias of your choice: "hm:" u_se< "Heatmap".
## A capture directory is an absolute path (see Capture). Layers and
## heads are numbered as the model numbers them, from 0 (head 5.1 is
## layer 5, head 1), as TransformerLens and the papers do.

"cp:" u_se< "Capture"

cell := 24
ink := "font-family=\"monospace\" fill=\"#1f2937\""

### Choosing a head

## `d p_attern (layer, head)`: the head's attention, query x key, by
## the model's numbering; a layer not captured or a head outside the
## model is an error.
l:p_attern := { d (l, h) ->
  A := cp:a_ttention d
  n := 2 s_elect s_hape A
  h < 0 ? "heatmap" []S_IGNAL d c_at ": no head " c_at f_ormat h
  h >= n ? "heatmap" []S_IGNAL d c_at ": no head " c_at (f_ormat h) c_at " (the model has " c_at (f_ormat n) c_at ", from 0)"
  ((d cp:p_osition l), h + 1) cp:h_ead A
}

### Pieces

## `p_ercent A`: weights as whole percents, rounded half up.
## >> "hm:" u_se< "Heatmap"
## >> hm:p_ercent 0.004 0.005 0.5 1.0
## 0 1 50 100
l:p_ercent := { A -> f_loor 0.5 + 100.0 * A }

## `x_ml s`: text made safe inside SVG (& < > " escaped).
## >> "hm:" u_se< "Heatmap"
## >> hm:x_ml "a<b"
## a&lt;b
l:x_ml := { s ->
  (t_ally s) = 0 ? s
  d_isclose 'h:j_oined r_/ 'h:e_scaped m_ap s
}

h:e_scaped := { c ->
  c = f_irst "&" ? "&amp;"
  c = f_irst "<" ? "&lt;"
  c = f_irst ">" ? "&gt;"
  c = f_irst "\"" ? "&quot;"
  r_avel c
}

h:j_oined := { a b -> e_nclose (d_isclose a) c_at d_isclose b }

## Boxed lines as one text, a newline after each.
h:l_ines := { B -> d_isclose 'h:j_oined r_/ '{ b -> (d_isclose b) c_at "\n" } m_ap B }

## The SVG text element for a label at (x, y); a is its extra attributes.
h:l_abel := { (x, y, a, s) ->
  "<text x=\"" c_at (f_ormat x) c_at "\" y=\"" c_at (f_ormat y) c_at "\" " c_at ink c_at " " c_at a c_at " xml:space=\"preserve\">" c_at (l:x_ml s) c_at "</text>"
}

### The picture

## `d s_vg (layer, head)`: the head's heatmap as SVG text: a title, the
## query tokens down the left, the key tokens along the top, and the
## cells drawn by []N_GRID on the heat scale.
l:s_vg := { d (l, h) ->
  note := "rows: queries, columns: keys. An observation, not causal evidence."
  P := l:p_ercent d l:p_attern (l, h)
  T := t_ally P
  toks := cp:t_okens d
  m := 12 + 7 * 'm_ax r_/ '[t_ally d_isclose] e_ach toks
  top := 44 + m
  n := cell * T
  w := (m + n + 12) m_ax 16 + 8 * t_ally note
  z := top + n + 12
  model := d_isclose f_irst d cp:t_exts "model"
  title := model c_at " layer " c_at (f_ormat l) c_at " head " c_at (f_ormat h) c_at ": attention, in percent"
  rows := '{ i -> h:l_abel ((m - 6), top + (cell * i - 1) + 12, "font-size=\"11\" text-anchor=\"end\" dominant-baseline=\"central\"", d_isclose i s_elect toks) } m_ap r_ange T
  cols := '{ i -> h:l_abel (0, 0, "font-size=\"11\" text-anchor=\"start\" dominant-baseline=\"central\" transform=\"translate(" c_at (f_ormat m + (cell * i - 1) + 12) c_at " " c_at (f_ormat top - 6) c_at ") rotate(-90)\"", d_isclose i s_elect toks) } m_ap r_ange T
  head := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" c_at (f_ormat w) c_at "\" height=\"" c_at (f_ormat z) c_at "\" viewBox=\"0 0 " c_at (f_ormat w) c_at " " c_at (f_ormat z) c_at "\" role=\"img\">\n<rect width=\"" c_at (f_ormat w) c_at "\" height=\"" c_at (f_ormat z) c_at "\" fill=\"#ffffff\"/>\n" c_at (h:l_abel (8, 18, "font-size=\"13\"", title)) c_at "\n" c_at (h:l_abel (8, 36, "font-size=\"11\"", note)) c_at "\n"
  grid := "<g class=\"cells\" transform=\"translate(" c_at (f_ormat m) c_at " " c_at (f_ormat top) c_at ")\">\n" c_at (([]S_CALE 2) []N_GRID P) c_at "</g>\n"
  head c_at "<g class=\"queries\">\n" c_at (h:l_ines rows) c_at "</g>\n<g class=\"keys\">\n" c_at (h:l_ines cols) c_at "</g>\n" c_at grid c_at "</svg>"
}
